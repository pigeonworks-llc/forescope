{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mold.schema.json",
  "title": "Mold — task-scoped spec (forescoping method)",
  "description": "A mold fixes one task's input -> output correspondence before it is built. It is the SoT that Claude Code (plan `mold:` pointer, ExitPlanMode advisory) and aiq (issue spec) both reference. Cross-field rules (argument/input one-to-one, verification per condition) are checked by mold-lint, not by this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "revision",
    "issued",
    "due",
    "fabless",
    "foundry",
    "function",
    "inputs",
    "files",
    "conditions",
    "verify"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "issued": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "due": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "fabless": {
      "$ref": "#/$defs/party"
    },
    "foundry": {
      "$ref": "#/$defs/party"
    },
    "function": {
      "type": "string",
      "description": "The decision function in one line: f(arg: type, ...): output",
      "pattern": "^f\\(.*\\)\\s*:\\s*\\S"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type",
          "domain"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "description": "The only paths the foundry reads or writes (repo-relative globs). Maps to aiq spec.files.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "when",
          "then"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^c[0-9]+$"
          },
          "when": {
            "type": "string",
            "minLength": 1
          },
          "then": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "verify": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "condition",
          "command"
        ],
        "properties": {
          "condition": {
            "type": "string",
            "pattern": "^c[0-9]+$"
          },
          "command": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "refs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "molds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "docs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "plan7_node": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "party": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "role"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
