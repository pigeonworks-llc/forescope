{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mold.schema.json",
  "title": "Mold (forescoping method, templates/structs.md Mold)",
  "description": "One task's parameters and test cases, fixed before it is built. Field names are English; each description gives the author's term (forescopingmethod PR #19). `files` and `test_cases[].command` are forescope extensions (not in the upstream class) and are marked as such. Cross-field rules (test data <-> parameter names, ID uniqueness) are checked by lintMold, not here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "revision",
    "issued",
    "due",
    "fabless",
    "foundry",
    "parameters",
    "test_cases",
    "files"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "モールドID"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "description": "リビジョン"
    },
    "issued": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "発行日"
    },
    "due": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "期限"
    },
    "fabless": {
      "type": "string",
      "minLength": 1,
      "description": "ファブレス (設計側の組織・人)"
    },
    "foundry": {
      "type": "string",
      "minLength": 1,
      "description": "ファウンドリ (製造側の組織・人)"
    },
    "parameters": {
      "type": "array",
      "minItems": 1,
      "description": "[Parameter] 受け取る値の定義、一件ごと",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "domain"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "description": "パラメータ名"
          },
          "domain": {
            "type": "string",
            "minLength": 1,
            "description": "値域"
          },
          "note": {
            "type": "string",
            "description": "補足"
          }
        }
      }
    },
    "test_cases": {
      "type": "array",
      "minItems": 1,
      "description": "[TestCase] パラメータにこの値を入れたらこうなる",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scenario", "data", "expected"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^TC-[0-9]{3,}$",
            "description": "テストケースID"
          },
          "scenario": {
            "type": "string",
            "minLength": 1,
            "description": "シナリオ"
          },
          "precondition": {
            "type": "string",
            "description": "事前条件"
          },
          "data": {
            "description": "テストデータ. Canonical form is a map parameter name -> value; a string is accepted but its names must appear as `name=` or `name:` tokens for lint 1-2.",
            "oneOf": [
              {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": true
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          },
          "expected": {
            "type": "string",
            "minLength": 1,
            "description": "期待結果 — written so that satisfied / not satisfied can be decided"
          },
          "command": {
            "type": "string",
            "minLength": 1,
            "description": "EXTENSION (forescope): shell command whose exit 0 means 期待結果 is satisfied. Absent = judged by a person/AI and reported via `forescope proof --response`."
          }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "description": "EXTENSION (forescope): the only repo-relative paths the foundry reads or writes. Maps to aiq spec.files.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "refs": {
      "type": "object",
      "additionalProperties": false,
      "description": "参照: [MoldID | 参照文書]",
      "properties": {
        "molds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "docs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "plan7_node": {
          "type": "string",
          "description": "EXTENSION (forescope): plan7 node ULID"
        }
      }
    }
  }
}
